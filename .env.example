# TheTransitClock docker stack — environment template.
#
# Copy this file to `.env` (which is gitignored) and fill in.
# Never commit a real password or API key.

# Password for the `transitclock` Postgres role. Used by the postgres
# init script, by Core / Tomcat to authenticate against Postgres, and
# by every admin command in setup.md §0. The example value below is
# fine for a local-only docker stack; rotate before exposing the
# Postgres port to anything outside localhost.
TRANSITCLOCK_DB_PASSWORD=changeme

# REST API key minted in setup.md §0 step 7 (CreateAPIKey.jar). Tomcat
# reads this via CATALINA_OPTS and bakes it into every JSP. Leave it
# blank during initial setup; fill in after CreateAPIKey prints the key
# and re-run `docker compose up -d tomcat`. Without it, the webapp
# renders apiKey="null" and every API call gets a 401.
TRANSITCLOCK_APIKEY=
