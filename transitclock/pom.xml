		</dependency>


		<!-- JUnit testing of course -->
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.13.2</version>
			<scope>test</scope>
		</dependency>
		<!-- Mockito 5.x uses the inline mock-maker by default. Hibernate 6.5
