		<!-- Hibernate ORM 6.5 — Jakarta-namespace line. groupId moved from
		     org.hibernate to org.hibernate.orm at the 6.x line. The
		     jpa-api / transaction-api versions below are the ones pulled
		     transitively by hibernate-core 6.5.3 — declared explicitly so
		     a future Hibernate bump that drifts the API version trips a
		     dep-resolver conflict instead of going unnoticed. -->
		<dependency>
		    <groupId>org.hibernate.orm</groupId>
		    <artifactId>hibernate-core</artifactId>
		    <version>6.5.3.Final</version>
		</dependency>
		<dependency>
		    <groupId>jakarta.persistence</groupId>
