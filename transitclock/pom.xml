		</dependency>

		<!-- https://mvnrepository.com/artifact/org.apache.commons/commons-jcs-core -->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-jcs-core</artifactId>
			<version>2.2</version>
		</dependency>

		<!-- Jakarta Servlet 6.1 — Tomcat 11 baseline. Provided scope: the
