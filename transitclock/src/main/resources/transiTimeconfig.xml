<?xml version="1.0" encoding="UTF-8"?>
<!--
  Legacy in-tree sample. Intentionally inert: the root element is
  <transitime>, but every typed ConfigValue in the codebase is registered
  under transitclock.* — so ConfigFileReader silently ignores everything
  here. The file is kept on the classpath because QuickStart-style harnesses
  look it up by name.

  The canonical user-facing sample for production deployments lives at
  ../../../docs/examples/transitclockConfig.xml — start from that one.
  Renaming this file's root to <transitclock> would activate the contents,
  including the hard-coded third-party URL below; do not do that without
  also replacing the URL with a real local value.
-->
<transitime>
    <modules>
        <optionalModulesList>org.transitclock.avl.GtfsRealtimeModule</optionalModulesList>
    </modules>
    <autoBlockAssigner>
        <autoAssignerEnabled>true</autoAssignerEnabled>
    </autoBlockAssigner>
    <core>
        <agencyId>02</agencyId>
    </core>
    <avl>
        <gtfsRealtimeFeedURI>http://realtime.prod.obahart.org:8088/vehicle-positions</gtfsRealtimeFeedURI>
        <!-- Optional bbox filter:
        <minLatitude>30.145125</minLatitude>
        <maxLatitude>30.517681</maxLatitude>
        <minLongitude>-98.072043</minLongitude>
        <maxLongitude>-97.495917</maxLongitude>
        -->
    </avl>
    <hibernate>
        <configFile>hsql_hibernate.cfg.xml</configFile>
    </hibernate>
</transitime>
